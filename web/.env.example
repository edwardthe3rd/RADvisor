# Public site origin (canonical URLs, sitemap, OpenGraph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Waitlist form POST target (API Gateway → Lambda → SES). Required in production
# for /app/waitlist; omit locally to fall back to Django at 127.0.0.1:8000.
NEXT_PUBLIC_WAITLIST_NOTIFY_URL=https://n9on65rkp2.execute-api.us-west-1.amazonaws.com/waitlist/notify

# Supabase (source of truth for all data — instructions/00_overview.md §2).
# NEXT_PUBLIC_ values are baked into the browser bundle; the anon key is
# public by design and protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-anon-key-here-no-angle-brackets

# Server-only — required for /admin writes and `npm run seed`.
# Never prefix with NEXT_PUBLIC_, never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-here

# Optional — direct Postgres URI for `npm run migrate` (Dashboard → Database → URI).
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# Shared secret for the /admin dashboard gate (any random string, 16+ chars).
ADMIN_SECRET=your-random-admin-secret
