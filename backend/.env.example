# backend/.env is auto-loaded by settings.py for local runs (real env vars win).
# Generate a key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-in-production
# DEBUG defaults to False. Set True for local development only — never in production.
DJANGO_DEBUG=True
# Required when DJANGO_DEBUG is off (comma-separated hostnames).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# API rate limits (DRF throttling). Defaults: anon 100/min, user 300/min, waitlist 10/hour.
# THROTTLE_ANON=100/min
# THROTTLE_USER=300/min
# THROTTLE_WAITLIST=10/hour

# Production only: set false if the proxy (ALB/Amplify) already forces https.
# DJANGO_SECURE_SSL_REDIRECT=true

DB_ENGINE=django.db.backends.postgresql
DB_NAME=radvisor
DB_USER=radvisor
DB_PASSWORD=radvisor
DB_HOST=db
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Optional — leave blank for template-based AI fallback
OPENAI_API_KEY=

# Google Places API (New) key for `python manage.py sync_reno_businesses`.
# Restrict the key to the Places API and set a quota cap. Never commit a real key.
GOOGLE_PLACES_API_KEY=

# Waitlist: set full Lambda function ARN to notify via SES inside Lambda (see infra/lambda/waitlist-notify/).
# Leave empty to use Django send_mail instead (console when DEBUG, or SMTP when configured).
# The Django host needs IAM lambda:InvokeFunction on this ARN at runtime.
WAITLIST_NOTIFY_LAMBDA_ARN=arn:aws:lambda:us-west-1:334321697715:function:radvisor-waitlist-notify-waitlist-notify
WAITLIST_NOTIFY_EMAIL=edward@radvisor.app

# Default From for Django send_mail fallback. Must be a verified SES identity (or alias under a verified domain).
DEFAULT_FROM_EMAIL="RADvisor <noreply@radvisor.app>"
