# API base URL used by src/api/client.ts.
#
# Local dev (Expo Go / simulator): leave unset or "auto" to auto-detect the
# Metro/Django LAN host, or point at your machine's IP:
#   EXPO_PUBLIC_API_BASE_URL=http://YOUR_IP:8000/api/v1
#
# Web / production builds (expo export -p web): set an explicit HTTPS URL to the
# deployed Django API. Required because LAN auto-detect only works in native dev.
#   EXPO_PUBLIC_API_BASE_URL=https://api.radvisor.com/api/v1
EXPO_PUBLIC_API_BASE_URL=auto
